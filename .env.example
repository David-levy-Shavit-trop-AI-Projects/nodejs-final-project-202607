# Copy this file to .env and fill in the real values.
# Never commit the real .env file.

# MongoDB Atlas connection string (without a trailing database name;
# each service selects its database name separately, see MONGODB_DB_NAME).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>

# Logical database name used by all four services.
MONGODB_DB_NAME=cost_manager

# One port per microservice when running locally.
LOGS_SERVICE_PORT=3001
USERS_SERVICE_PORT=3002
COSTS_SERVICE_PORT=3003
ABOUT_SERVICE_PORT=3004

# Comma-separated "first_name:last_name" pairs for the /api/about endpoint.
TEAM_MEMBERS=Shavit:Trop,David:Levy

# Log level for Pino (trace|debug|info|warn|error|fatal|silent).
LOG_LEVEL=info
